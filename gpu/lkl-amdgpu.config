# Added to LKL's defconfig: amdgpu for the Ryzen 9000 iGPU (Granite Ridge,
# GC 10.3.6 / DCN 3.1.5 / PSP 13.0.5). build-lkl.sh adds the built-in
# firmware list (and the VBIOS, when it has the VFCT table).
CONFIG_MMU=y
CONFIG_PCI=y
# GNU Mach has no MSI: legacy INTx only
# CONFIG_PCI_MSI is not set
CONFIG_FW_LOADER=y
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMD_DC=y
# CONFIG_DRM_AMDGPU_SI is not set
# CONFIG_DRM_AMDGPU_CIK is not set
# CONFIG_DRM_AMDGPU_USERPTR is not set
# CONFIG_DRM_AMD_ACP is not set
# CONFIG_HSA_AMD is not set
# CONFIG_ACPI is not set
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_DEBUG_FS is not set
# test device for the Hurd PCI host code (QEMU virtio-blk-pci)
CONFIG_VIRTIO_PCI=y
# CONFIG_VIRTIO_PCI_LEGACY is not set
# DRM device nodes inside LKL, and a virtual display to test KMS without hardware
CONFIG_DEVTMPFS=y
CONFIG_DRM_VKMS=y
# where LKL puts its RAM and user mappings: well clear of the program, which
# the Hurd loads low (non-PIE at 0x400000, LKL's default mmap base is 0x100000)
CONFIG_LKL_MEMORY_START=0x4000000000
CONFIG_LKL_TASK_UNMAPPED_BASE=0x1000000000
