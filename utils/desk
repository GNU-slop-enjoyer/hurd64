#!/bin/sh
# desk: start the hurd96 desktop (the lilith compositor) from the console.
# Super+Shift+Q quits and brings the console back. Super+Q opens a terminal.
log=/var/log/desk.log
if [ "$(id -u)" != 0 ]; then
	echo "desk: needs root (the screen and the keyboard belong to root)" >&2
	exit 1
fi
export PATH=/usr/local/bin:$PATH
# the keyboard layout the Debian way (XKBLAYOUT=de, ...)
if [ -r /etc/default/keyboard ]; then
	. /etc/default/keyboard
	[ -n "$XKBLAYOUT" ] && export XKB_DEFAULT_LAYOUT="$XKBLAYOUT"
	[ -n "$XKBVARIANT" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
	[ -n "$XKBOPTIONS" ] && export XKB_DEFAULT_OPTIONS="$XKBOPTIONS"
	[ -n "$XKBMODEL" ] && export XKB_DEFAULT_MODEL="$XKBMODEL"
fi
# foot wants a UTF-8 locale
export LANG=C.UTF-8
export XCURSOR_THEME=DMZ-Black
unset LC_ALL LC_CTYPE
cd "${HOME:-/root}"
/usr/local/bin/lilith "$@" >/dev/null 2>"$log"
status=$?
if [ $status != 0 ]; then
	# make sure the console has the screen again
	/usr/local/sbin/fbconsole 2>/dev/null
	echo "desk: stopped (exit $status), see $log:" >&2
	tail -5 "$log" >&2
fi
exit $status
