+			    enum lkl_prot prot);
 
 	struct lkl_dev_pci_ops *pci_ops;
 };
diff --git a/arch/lkl/mm/mmu_mem.c b/arch/lkl/mm/mmu_mem.c
index a11358669..931ef242a 100644
--- a/arch/lkl/mm/mmu_mem.c
+++ b/arch/lkl/mm/mmu_mem.c
@@ -46,7 +46,12 @@ void mmap_pages_for_ptes(unsigned long va, unsigned int nr, pte_t pte)
 	unsigned long pa = pte.pte & PAGE_MASK;
 	unsigned long pg_off = pa - (ARCH_PFN_OFFSET << PAGE_SHIFT);
 
-	void *res = lkl_ops->shmem_mmap((void *)va, pg_off, PAGE_SIZE * nr, prot);
+	void *res = pfn_valid(pa >> PAGE_SHIFT) ?
+		lkl_ops->shmem_mmap((void *)va, pg_off, PAGE_SIZE * nr, prot) :
+		/* not RAM: device memory, e.g. a GPU buffer in VRAM; its
+		   "physical" address is where the host mapped the BAR */
+		lkl_ops->iomem_mmap ?
+		lkl_ops->iomem_mmap((void *)va, (void *)pa, PAGE_SIZE * nr, prot) : NULL;
 
 	BUG_ON(res != (void *)va);
 }
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
index 45affc025..ea03cb2ca 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
@@ -33,6 +33,7 @@
 #include <linux/pci.h>
 #include <linux/slab.h>
 #include <linux/acpi.h>
+#include <linux/firmware.h>
 /*
  * BIOS.
  */
@@ -408,6 +409,33 @@ static inline bool amdgpu_acpi_vfct_bios(struct amdgpu_device *adev)
 }
 #endif
 
+#ifdef CONFIG_LKL
+/*
+ * LKL has no ACPI, so no VFCT table: the host may hand the VBIOS in as
+ * firmware instead, amdgpu/vbios_<device id>.bin (taken from the VFCT).
+ */
+static bool amdgpu_read_bios_from_file(struct amdgpu_device *adev)
+{
+	const struct firmware *fw;
+	char name[40];
+
+	snprintf(name, sizeof(name), "amdgpu/vbios_%04x.bin", adev->pdev->device);
+	if (request_firmware_direct(&fw, name, adev->dev))
+		return false;
+	adev->bios = kmemdup(fw->data, fw->size, GFP_KERNEL);
+	adev->bios_size = fw->size;
+	release_firmware(fw);
+	if (!adev->bios)
+		return false;
+	if (!check_atom_bios(adev->bios, adev->bios_size)) {
+		kfree(adev->bios);
+		adev->bios = NULL;
+		return false;
+	}
+	return true;
+}
+#endif
+
 static bool amdgpu_get_bios_apu(struct amdgpu_device *adev)
 {
 	if (amdgpu_acpi_vfct_bios(adev)) {
@@ -430,6 +458,13 @@ static bool amdgpu_get_bios_apu(struct amdgpu_device *adev)
 		goto success;
 	}
 
+#ifdef CONFIG_LKL
+	if (amdgpu_read_bios_from_file(adev)) {
+		dev_info(adev->dev, "Fetched VBIOS from firmware file\n");
+		goto success;
+	}
+#endif
+
 	dev_err(adev->dev, "Unable to locate a BIOS ROM\n");
 	return false;
 
