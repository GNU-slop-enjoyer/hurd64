diff --git a/tools/lkl/lib/posix-host.c b/tools/lkl/lib/posix-host.c
index 2f4e0191d..c955cc123 100644
--- a/tools/lkl/lib/posix-host.c
+++ b/tools/lkl/lib/posix-host.c
@@ -542,6 +542,10 @@ static void *lkl_shmem_mmap(void *addr, unsigned long pg_off,
 	int flags = MAP_SHARED | MAP_FIXED_NOREPLACE;
 	void *ret = mmap(addr, size, prot, flags, shared_mem_fd, pg_off);
 
+	/* /dev/shm is often mounted noexec */
+	if (ret == MAP_FAILED && (prot & PROT_EXEC))
+		ret = mmap(addr, size, prot & ~PROT_EXEC, flags, shared_mem_fd, pg_off);
+
 	if (ret == MAP_FAILED)
 		return NULL;
 	return ret;
