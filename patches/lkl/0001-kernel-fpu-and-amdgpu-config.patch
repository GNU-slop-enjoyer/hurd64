 	void (*shmem_init)(unsigned long size);
 	void *(*shmem_mmap)(void *addr, unsigned long pg_off, unsigned long size,
 				enum lkl_prot prot);
+	/* map device memory (a BAR the host mapped at iomem) at addr */
