diff --git a/arch/lkl/include/asm/fpu.h b/arch/lkl/include/asm/fpu.h
new file mode 100644
index 000000000..584f75e12
--- /dev/null
+++ b/arch/lkl/include/asm/fpu.h
@@ -0,0 +1,14 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_LKL_FPU_H
+#define _ASM_LKL_FPU_H
+
+/*
+ * LKL runs as host threads and only one of them is in the kernel at a
+ * time, so the host already keeps every thread's FPU state: kernel code
+ * may use the FPU whenever it likes.
+ */
+#define kernel_fpu_available()	true
+static inline void kernel_fpu_begin(void) { }
+static inline void kernel_fpu_end(void) { }
+
+#endif
