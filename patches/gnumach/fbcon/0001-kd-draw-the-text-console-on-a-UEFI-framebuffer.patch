diff --git a/i386/i386at/kdfb.c b/i386/i386at/kdfb.c
new file mode 100644
index 00000000..93759c59
--- /dev/null
+++ b/i386/i386at/kdfb.c
@@ -0,0 +1,239 @@
+/*
+ * Copyright (C) 2026 Free Software Foundation, Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2, or (at your option)
+ * any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program; if not, write to the Free Software
+ * Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
+ */
+
+/*
+ * kd text console on a linear framebuffer.
+ *
+ * UEFI machines have no VGA text mode; the firmware (through the multiboot
+ * framebuffer tag) hands over a linear RGB framebuffer instead.  kd keeps
+ * using its 80x25 "EGA" cell grid; these functions keep that grid in a
+ * shadow buffer and draw each cell as an 8x16 glyph.  The framebuffer can
+ * only be mapped once kernel VM is up (kdfb_map, from machine_init); kd
+ * itself may start before or after that, and whichever comes second draws
+ * the grid.
+ */
+
+#include <string.h>
+#include <mach/machine/multiboot.h>
+#include <mach/vm_prot.h>
+#include <vm/vm_kern.h>
+#include <i386at/kd.h>
+#include <i386at/kdsoft.h>
+#include <i386at/kdfb.h>
+
+#include "kdfb_font.h"
+
+#define COLS		80
+#define ROWS		25
+#define CELLS		(COLS * ROWS)
+#define GLYPH_W		8
+#define GLYPH_H		16
+
+extern struct multiboot_raw_info boot_info;
+
+static unsigned short shadow[CELLS];	/* char | attr << 8 */
+static volatile unsigned char *fb;	/* NULL until mapped */
+static unsigned int pitch, width, height, ox, oy, bytespp;
+static unsigned int cursor = CELLS;	/* cell index, CELLS = none drawn */
+static unsigned int rgb[16];		/* VGA palette in the framebuffer's format */
+
+/* the 16 VGA text colours */
+static const unsigned char vga[16][3] = {
+	{0x00, 0x00, 0x00}, {0x00, 0x00, 0xaa}, {0x00, 0xaa, 0x00}, {0x00, 0xaa, 0xaa},
+	{0xaa, 0x00, 0x00}, {0xaa, 0x00, 0xaa}, {0xaa, 0x55, 0x00}, {0xaa, 0xaa, 0xaa},
+	{0x55, 0x55, 0x55}, {0x55, 0x55, 0xff}, {0x55, 0xff, 0x55}, {0x55, 0xff, 0xff},
+	{0xff, 0x55, 0x55}, {0xff, 0x55, 0xff}, {0xff, 0xff, 0x55}, {0xff, 0xff, 0xff},
+};
+
+static unsigned int
+channel(unsigned char v, unsigned int pos, unsigned int size)
+{
+	if (size == 0)
+		return 0;
+	return ((unsigned int) v >> (8 - (size > 8 ? 8 : size))) << pos;
+}
+
+/* 32 or 24 bits per pixel, little-endian */
+static inline void
+put_pixel(volatile unsigned char *p, unsigned int color)
+{
+	if (bytespp == 4) {
+		*(volatile unsigned int *) p = color;
+	} else {
+		p[0] = color;
+		p[1] = color >> 8;
+		p[2] = color >> 16;
+	}
+}
+
+static void
+draw_cell(unsigned int cell)
+{
+	unsigned short v = shadow[cell];
+	const unsigned char *glyph = &kdfb_font[(v & 0xff) * GLYPH_H];
+	unsigned int fg = rgb[(v >> 8) & 0x0f], bg = rgb[(v >> 12) & 0x07];
+	unsigned int x = ox + (cell % COLS) * GLYPH_W;
+	unsigned int y = oy + (cell / COLS) * GLYPH_H;
+
+	if (!fb)
+		return;
+	for (unsigned int r = 0; r < GLYPH_H; r++) {
+		volatile unsigned char *row = fb + (y + r) * pitch + x * bytespp;
+		unsigned char bits = glyph[r];
+
+		/* the cursor is an underline on the last two rows */
+		if (cell == cursor && r >= GLYPH_H - 2)
+			bits = 0xff;
+		for (unsigned int c = 0; c < GLYPH_W; c++)
+			put_pixel(row + c * bytespp, (bits & (0x80 >> c)) ? fg : bg);
+	}
+}
+
+static void
+redraw(unsigned int from, unsigned int count)
+{
+	for (unsigned int i = from; i < from + count && i < CELLS; i++)
+		draw_cell(i);
+}
+
+/* kd positions are byte offsets into an EGA page: 2 bytes per cell */
+#define CELL(pos)	((unsigned int) (pos) / ONE_SPACE)
+
+static void
+kdfb_put(csrpos_t pos, char ch, char attr)
+{
+	unsigned int cell = CELL(pos);
+
+	if (cell >= CELLS)
+		return;
+	shadow[cell] = (unsigned char) ch | ((unsigned char) attr << 8);
+	draw_cell(cell);
+}
+
+static void
+kdfb_mvup(csrpos_t from, csrpos_t to, int count)
+{
+	unsigned int f = CELL(from), t = CELL(to);
+
+	if (count <= 0 || f >= CELLS || t >= CELLS)
+		return;
+	if (f + count > CELLS)
+		count = CELLS - f;
+	memmove(&shadow[t], &shadow[f], count * sizeof shadow[0]);
+	redraw(t, count);
+}
+
+static void
+kdfb_mvdown(csrpos_t from, csrpos_t to, int count)
+{
+	/* kd passes the last cell of each block: move [from-count+1, from] */
+	unsigned int f = CELL(from), t = CELL(to);
+
+	if (count <= 0 || f >= CELLS || t >= CELLS || (unsigned int) count > f + 1
+	    || (unsigned int) count > t + 1)
+		return;
+	memmove(&shadow[t - count + 1], &shadow[f - count + 1], count * sizeof shadow[0]);
+	redraw(t - count + 1, count);
+}
+
+static void
+kdfb_clear(csrpos_t to, int count, char attr)
+{
+	unsigned int t = CELL(to);
+
+	for (unsigned int i = t; i < t + count && i < CELLS; i++)
+		shadow[i] = ' ' | ((unsigned char) attr << 8);
+	redraw(t, count);
+}
+
+static void
+kdfb_setcursor(csrpos_t pos)
+{
+	unsigned int old = cursor;
+
+	/* kd_setpos leaves storing the position to the display hook */
+	kd_curpos = pos;
+	cursor = CELL(pos);
+	if (old < CELLS)
+		draw_cell(old);
+	if (cursor < CELLS)
+		draw_cell(cursor);
+}
+
+/* A framebuffer the console can draw on: linear, 24 or 32 bits per pixel. */
+static int
+usable(void)
+{
+	const struct multiboot_framebuffer_info *f = &boot_info.fb_info;
+
+	return (boot_info.flags & MULTIBOOT_FRAMEBUFFER)
+		&& f->framebuffer_type == MULTIBOOT_FRAMEBUFFER_TYPE_RGB
+		&& (f->framebuffer_bpp == 32 || f->framebuffer_bpp == 24)
+		&& f->framebuffer_addr != 0
+		&& f->framebuffer_width >= COLS * GLYPH_W
+		&& f->framebuffer_height >= ROWS * GLYPH_H;
+}
+
+int
+kdfb_setup(void)
+{
+	if (!usable())
+		return 0;
+	if (kd_dput == kdfb_put)
+		return 1;
+	for (unsigned int i = 0; i < CELLS; i++)
+		shadow[i] = ' ' | (KA_NORMAL << 8);
+	kd_dput = kdfb_put;
+	kd_dmvup = kdfb_mvup;
+	kd_dmvdown = kdfb_mvdown;
+	kd_dclear = kdfb_clear;
+	kd_dsetcursor = kdfb_setcursor;
+	/* kd may start after kdfb_map() has run */
+	redraw(0, CELLS);
+	return 1;
+}
+
+void
+kdfb_map(void)
+{
+	const struct multiboot_framebuffer_info *f = &boot_info.fb_info;
+
+	if (!usable() || fb)
+		return;
+	pitch = f->framebuffer_pitch;
+	bytespp = f->framebuffer_bpp / 8;
+	width = f->framebuffer_width;
+	height = f->framebuffer_height;
+	/* centre the 640x400 text area */
+	ox = (width - COLS * GLYPH_W) / 2;
+	oy = (height - ROWS * GLYPH_H) / 2;
+	for (int i = 0; i < 16; i++)
+		rgb[i] = channel(vga[i][0], f->framebuffer_red_field_position, f->framebuffer_red_mask_size)
+			| channel(vga[i][1], f->framebuffer_green_field_position, f->framebuffer_green_mask_size)
+			| channel(vga[i][2], f->framebuffer_blue_field_position, f->framebuffer_blue_mask_size);
+
+	unsigned char *m = kmem_map_aligned_table(f->framebuffer_addr,
+						  (vm_size_t) pitch * height,
+						  VM_PROT_READ | VM_PROT_WRITE);
+	if (!m)
+		return;
+	/* black around the text area */
+	memset(m, 0, (vm_size_t) pitch * height);
+	fb = m;
+	redraw(0, CELLS);
+}
