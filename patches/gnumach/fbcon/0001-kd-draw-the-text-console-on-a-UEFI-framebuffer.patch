 i386/i386at/kd.c        |   4 +
 i386/i386at/kdfb.c      | 239 ++++++++++++++++++++++++++++++++++++
 i386/i386at/kdfb.h      |  30 +++++
 i386/i386at/kdfb_font.h | 260 ++++++++++++++++++++++++++++++++++++++++
 i386/i386at/model_dep.c |  12 ++
 x86_64/Makefrag.am      |   3 +
 7 files changed, 551 insertions(+)
 create mode 100644 i386/i386at/kdfb.c
 create mode 100644 i386/i386at/kdfb.h
