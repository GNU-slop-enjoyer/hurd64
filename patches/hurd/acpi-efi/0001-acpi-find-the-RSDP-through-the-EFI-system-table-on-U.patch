From d0a5c2baadb8ecce1a19da511641e8a3841ccee9 Mon Sep 17 00:00:00 2001
From: GNU-slop-enjoyer <johnepstein420@gmail.com>
Date: Thu, 29 Oct 2026 16:06:13 +0100
Subject: [PATCH] acpi: find the RSDP through the EFI system table on UEFI
 machines

ACPICA scans the BIOS area for the RSDP, which UEFI firmware need not
provide. GNU Mach reports the EFI system table through host_info
(HOST_EFI_SYSTAB); walk its configuration table for the ACPI 2.0 or
1.0 entry and fall back to the BIOS scan when there is none.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 acpi/Makefile |   4 +-
 acpi/efi.c    | 133 ++++++++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 136 insertions(+), 1 deletion(-)
 create mode 100644 acpi/efi.c

diff --git a/acpi/Makefile b/acpi/Makefile
index 6e91e980..b20af3fe 100644
--- a/acpi/Makefile
+++ b/acpi/Makefile
@@ -22,13 +22,15 @@ PORTDIR = $(srcdir)/port
 
 SRCS           = main.c netfs_impl.c acpi.c \
                  acpifs.c ncache.c options.c func_files.c acpi-ops.c \
-                 acpiServer.c startup_notifyServer.c
+                 acpiServer.c startup_notifyServer.c efi.c
 
 MIGSRCS        =
 OBJS           = $(patsubst %.S,%.o,$(patsubst %.c,%.o, $(SRCS) $(MIGSRCS)))
 
 HURDLIBS= fshelp ports shouldbeinlibc netfs iohelp ihash machdev trivfs irqhelp
 LDLIBS = -lpthread $(libacpica_LIBS)
+# efi.c finds the RSDP through the EFI system table before ACPICA scans the BIOS area
+LDFLAGS += -Wl,--wrap=acpi_os_get_root_pointer
 
 target = acpi acpi.static
 
diff --git a/acpi/efi.c b/acpi/efi.c
new file mode 100644
index 00000000..843cc6c3
--- /dev/null
+++ b/acpi/efi.c
@@ -0,0 +1,133 @@
