From 8ef0d2ef7f472ad7615a69a6c3da4268df79c4d8 Mon Sep 17 00:00:00 2001
From: GNU-slop-enjoyer <johnepstein420@gmail.com>
Date: Thu, 29 Oct 2026 17:03:51 +0100
Subject: [PATCH] rumpnet: link the rge(4) component for Realtek RTL8125 NICs

Needs a rumpkernel with debian/patches/rge-rump.diff.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 rumpnet/Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/rumpnet/Makefile b/rumpnet/Makefile
index 579197e1..41b39a59 100644
--- a/rumpnet/Makefile
+++ b/rumpnet/Makefile
@@ -15,7 +15,7 @@
 #   along with this program; if not, write to the Free Software
 #   Foundation, Inc., 675 Mass Ave, Cambridge, MA 02139, USA.
 
-RUMPLIBS=rump rumpuser rumpdev rumpdev_miiphy rumpdev_pci rumpvfs rumpdev_pci_if_wm rumpnet rumpnet_net rumpnet_netinet rumpnet_local rumpdev_bpf
+RUMPLIBS=rump rumpuser rumpdev rumpdev_miiphy rumpdev_pci rumpvfs rumpdev_pci_if_wm rumpdev_pci_if_rge rumpnet rumpnet_net rumpnet_netinet rumpnet_local rumpdev_bpf
 # If we have a configured tree, include the configuration so that we
 # can conditionally build translators.
 ifneq (,$(wildcard ../config.make))
-- 
2.55.0

